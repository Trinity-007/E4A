# MongoDB connection string (replace with your URI)
MONGODB_URI=mongodb://mongo:27017/e4a_db

# JWT secret for signing tokens
JWT_SECRET=replace_this_with_a_strong_secret

# Port for the backend
PORT=3000

# Email Configuration (REQUIRED for welcome emails on signup)
# Users will receive a welcome email when they sign up
# Choose ONE of the options below:

# ===== OPTION 1: Gmail (Recommended for Development) =====
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=noreply@e4a.com

# Gmail Setup Instructions:
# 1. Go to https://myaccount.google.com/security
# 2. Enable "2-Step Verification"
# 3. Search for "App passwords" in the same page
# 4. Select "Mail" and "Windows Computer" (or your device)
# 5. Generate app password (16 characters)
# 6. Copy that password to EMAIL_PASSWORD above
# 7. Use your full Gmail address in EMAIL_USER

# ===== OPTION 2: Custom SMTP (Mailtrap, SendGrid, etc.) =====
# EMAIL_SERVICE=custom
# EMAIL_HOST=smtp.mailtrap.io
# EMAIL_PORT=2525
# EMAIL_USER=your_smtp_user
# EMAIL_PASSWORD=your_smtp_password
# EMAIL_FROM=no-reply@yourdomain.com

# Site URL (used in emails for action links)
SITE_URL=http://localhost:3000

# Node Environment
NODE_ENV=development

# ===== EMAIL TESTING IN DEVELOPMENT =====
# If EMAIL_USER is empty/not set, emails will log to console
# This allows testing signup without real email configuration
